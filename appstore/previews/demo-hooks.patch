+/// App Preview capture only (scratch copy): puts the window at the frame the
+/// capture region expects, given as "x,y,w,h" in top-left screen points.
+struct DemoWindowFrame: ViewModifier {
+    func body(content: Content) -> some View {
+        content.task {
+            guard let spec = ProcessInfo.processInfo.environment["DEMO_WINDOW"] else { return }
+            let v = spec.split(separator: ",").compactMap { Double($0) }
+            guard v.count == 4 else { return }
+            for _ in 0..<40 {
+                if let window = NSApp.windows.first(where: { $0.isVisible && $0.contentView != nil }),
+                   let screen = NSScreen.screens.first {
+                    let frame = NSRect(x: v[0], y: screen.frame.height - v[1] - v[3], width: v[2], height: v[3])
+                    window.setFrame(frame, display: true, animate: false)
+                    return
+                }
+                try? await Task.sleep(for: .milliseconds(100))
+            }
+        }
+    }
+}
+#endif
