    "duplicate.notFound.detail" : {
      "comment" : "A message that appears when the app can't find a QR code in an image.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرب صورة أكثر وضوحًا، أو صورة يظهر فيها الكود بالكامل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
