    "help.deepLinks.detail" : {
      "comment" : "Detail text for the \"Automation & Shortcuts\" section of the HelpView.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للتطبيقات والأتمتة الأخرى فتح Radical QR بمحتوى باستخدام مخطط URL radicalqr://. متوافق مع الاختصارات وأدوات التشغيل الآلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Anwendungen und Automatisierungen können Radical QR mit Inhalten öffnen, die das URL-Schema radicalqr:// verwenden. Kompatibel mit Shortcuts und Automatisierungstools."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Other apps and automations can open Radical QR with content using the radicalqr:// URL scheme. Compatible with Shortcuts and automation tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otras aplicaciones y automatizaciones pueden abrir Radical QR con contenido utilizando el esquema radicalqr:// URL. Compatible con accesos directos y herramientas de automatización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'autres applications et automatismes peuvent ouvrir Radical QR avec du contenu utilisant le schéma d'URL radicalqr://. Compatible avec les raccourcis et les outils d'automatisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अन्य ऐप्स और ऑटोमेशन radicalqr:// URL स्कीम का उपयोग करके सामग्री के साथ Radical QR खोल सकते हैं। शॉर्टकट्स और ऑटोमेशन टूल्स के साथ संगत।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altre applicazioni e automazioni possono aprire Radical QR con contenuti che utilizzano lo schema URL radicalqr://. Compatibile con le scorciatoie e gli strumenti di automazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のアプリやオートメーションは、radicalqr:// URLスキームを使用したコンテンツでRadical QRを開くことができます。ショートカットや自動化ツールと互換性があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outras aplicações e automações podem abrir o Radical QR com conteúdo usando o esquema de URL radicalqr://. Compatível com atalhos e ferramentas de automatização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他应用程序和自动化工具可使用 radicalqr:// URL 方案打开 Radical QR 内容。与快捷方式和自动化工具兼容。"
          }
        }
      }
    },
