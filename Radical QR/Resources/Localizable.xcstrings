        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक तीक्ष्ण तस्वीर आज़माएँ, या ऐसी तस्वीर जिसमें पूरा कोड दिखाई दे।"
          }
        },
        "it" : {
          "stringUnit" : {
