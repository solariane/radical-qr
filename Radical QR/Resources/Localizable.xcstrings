    "help.shape.detail" : {
      "comment" : "Detail text for the shape and roundness section of the help view.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط استدارة الوحدة من المربعات الحادة إلى الدوائر الكاملة. يمكن ضبط نمط زاوية العين وحجمها بشكل مستقل للحصول على تصميمات فريدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellen Sie die Rundheit der Module von scharfen Quadraten bis hin zu vollen Kreisen ein. Stil und Größe der Augenwinkel können für einzigartige Designs unabhängig voneinander eingestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjust module roundness from sharp squares to full circles. Eye corner style and size can be set independently for unique designs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste la redondez del módulo desde cuadrados nítidos a círculos completos. El estilo y el tamaño de las esquinas de los ojos se pueden ajustar de forma independiente para obtener diseños únicos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez la rondeur des modules, des carrés pointus aux cercles complets. Le style et la taille du coin de l'œil peuvent être réglés indépendamment pour des conceptions uniques."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मॉड्यूल की गोलता को तीखे चौकोर से लेकर पूर्ण वृत्त तक समायोजित करें।  अद्वितीय डिज़ाइनों के लिए आई कॉर्नर की शैली और आकार स्वतंत्र रूप से सेट किए जा सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regolazione della rotondità dei moduli, da quadrati appuntiti a cerchi pieni. Lo stile e la dimensione degli angoli degli occhi possono essere impostati in modo indipendente per ottenere design unici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シャープな四角形から完全な円形まで、モジュールの丸みを調整できます。目尻のスタイルとサイズは、ユニークなデザインのために独立して設定することができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o arredondamento dos módulos, desde quadrados nítidos a círculos completos. O estilo e o tamanho dos cantos dos olhos podem ser definidos de forma independente para designs únicos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可调整模块的圆度，从尖锐的方形到完整的圆形。眼角样式和大小可独立设置，以实现独特的设计。"
          }
        }
      }
    },
