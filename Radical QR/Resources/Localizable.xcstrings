    "help.presets.detail" : {
      "comment" : "Detail text for the \"Style Presets\" row in the \"Pro Features\" section of the Help view.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ النمط المفضل لديك كإعداد مسبق قابل لإعادة الاستخدام - الألوان، والتدرج، والاستدارة والمزيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern Sie Ihren Lieblingsstil als wiederverwendbare Voreinstellung - Farben, Farbverlauf, Rundung und mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save your favorite style as a reusable preset -- colors, gradient, roundness, and more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde su estilo favorito como un preajuste reutilizable: colores, degradado, redondez y mucho más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez votre style préféré en tant que préréglage réutilisable - couleurs, dégradé, rondeur, etc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने पसंदीदा स्टाइल को एक पुन: प्रयोज्य प्रीसेट के रूप में सहेजें -- रंग, ग्रेडिएंट, गोलता, और भी बहुत कुछ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvate il vostro stile preferito come preimpostazione riutilizzabile: colori, sfumatura, rotondità e altro ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色、グラデーション、丸みなど、お気に入りのスタイルを再利用可能なプリセットとして保存できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde o seu estilo favorito como uma predefinição reutilizável: cores, gradiente, arredondamento e muito mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你喜欢的样式保存为可重复使用的预设 - 颜色、渐变、圆度等。"
          }
        }
      }
    },
