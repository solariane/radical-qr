    "help.intro" : {
      "comment" : "An introductory text for the \"Supported Formats\" help view, explaining that QR codes can encode different types of data and that the app automatically detects and optimizes the format for you.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لرموز QR ترميز أنواع مختلفة من البيانات. يكتشف التطبيق تلقائياً التنسيق ويحسّنه لك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-Codes können verschiedene Arten von Daten kodieren. Die App erkennt das Format automatisch und optimiert es für Sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "QR codes can encode different types of data. The app automatically detects and optimizes the format for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los códigos QR pueden codificar diferentes tipos de datos. La aplicación detecta y optimiza automáticamente el formato por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codes QR peuvent encoder différents types de données. L'application détecte et optimise automatiquement le format pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR कोड विभिन्न प्रकार के डेटा को एन्कोड कर सकते हैं। ऐप स्वचालित रूप से आपके लिए प्रारूप का पता लगाता है और उसे अनुकूलित करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I codici QR possono codificare diversi tipi di dati. L'app rileva e ottimizza automaticamente il formato per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QRコードは様々な種類のデータをエンコードできます。アプリが自動的に形式を検出し、最適化します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os códigos QR podem codificar diferentes tipos de dados. A aplicação deteta e otimiza automaticamente o formato para si."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR 码可以编码不同类型的数据。该程序会自动检测并为您优化格式。"
          }
        }
      }
    },
    "help.logoHelp.detail" : {
      "comment" : "Detail text for the \"Logo Embedding\" help row.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب صورة أو حددها لتضمين شعارك في وسط رمز QR. يتم ضبط الهامش الشفاف المحيط به تلقائيًا بحيث يظل الرمز قابلاً للمسح الضوئي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie ein Bild per Drag & Drop in das Feld oder wählen Sie es aus, um Ihr Logo in der Mitte des QR-Codes einzufügen. Der freie Rand um das Logo herum wird automatisch so angepasst, dass der Code weiterhin gescannt werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drop or select an image to embed your logo at the center of the QR code. The clear margin around it is managed automatically so the code still scans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra y suelta o selecciona una imagen para insertar tu logotipo en el centro del código QR. El margen transparente que lo rodea se gestiona automáticamente para que el código siga pudiéndose escanear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez ou sélectionnez une image pour intégrer votre logo au centre du code QR. La marge blanche autour du logo est gérée automatiquement afin que le code reste lisible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR कोड के केंद्र में अपना लोगो एम्बेड करने के लिए एक छवि ड्रॉप करें या चुनें। इसके चारों ओर का पारदर्शी मार्जिन स्वचालित रूप से प्रबंधित किया जाता है ताकि कोड अभी भी स्कैन हो सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina o seleziona un'immagine per inserire il tuo logo al centro del codice QR. Il margine trasparente attorno al logo viene gestito automaticamente in modo che il codice sia comunque leggibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像をドラッグ＆ドロップするか、選択して、QRコードの中央にロゴを埋め込んでください。周囲の余白は自動的に調整されるため、QRコードは正常に読み取られます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste e solte ou selecione uma imagem para inserir seu logotipo no centro do código QR. A margem em branco ao redor é ajustada automaticamente para que o código continue sendo lido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖放或选择一张图片，即可将您的徽标嵌入二维码中央。二维码周围的空白边距会自动调整，以确保二维码仍可被扫描。"
          }
        }
      }
    },
