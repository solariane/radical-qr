          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Try a sharper picture, or one where the whole code is visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba con una imagen más nítida o en la que se vea todo el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
