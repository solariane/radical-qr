    "help.caption.detail" : {
      "comment" : "Detail text for the \"Captions\" row in the \"Customization\" section of the help view.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف تعليقًا نصيًا أسفل رمز الاستجابة السريعة. يقترح التطبيق تعليقًا بناءً على نوع المحتوى، أو يمكنك كتابة التعليق الخاص بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie eine Textbeschriftung unter dem QR-Code hinzu. Die App schlägt eine Beschriftung basierend auf dem Inhaltstyp vor, oder Sie können Ihre eigene schreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add a text caption below the QR code. The app suggests a caption based on the content type, or you can write your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una leyenda debajo del código QR. La aplicación sugiere un pie de foto basado en el tipo de contenido, o puedes escribir el tuyo propio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une légende sous le code QR. L'application propose une légende basée sur le type de contenu, ou vous pouvez écrire la vôtre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR कोड के नीचे एक टेक्स्ट कैप्शन जोड़ें। ऐप सामग्री के प्रकार के आधार पर एक कैप्शन सुझाता है, या आप अपना खुद का कैप्शन लिख सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungete una didascalia di testo sotto il codice QR. L'applicazione suggerisce una didascalia in base al tipo di contenuto, oppure è possibile scriverne una propria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QRコードの下にテキストキャプションを追加します。アプリはコンテンツの種類に基づいてキャプションを提案しますが、自分で書くこともできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma legenda de texto por baixo do código QR. A aplicação sugere uma legenda com base no tipo de conteúdo, ou pode escrever a sua própria legenda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 QR 代码下方添加文字说明。应用程序会根据内容类型推荐标题，您也可以自己编写标题。"
          }
        }
      }
    },
