    "help.input.detail" : {
      "comment" : "Detailed description of how to use the app to generate QR codes by typing or pasting text.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل أي نص أو عنوان URL أو بريد إلكتروني أو رقم هاتف أو بيانات منظمة. يقوم التطبيق على الفور بإنشاء رمز QR أثناء الكتابة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie einen beliebigen Text, eine URL, eine E-Mail, eine Telefonnummer oder strukturierte Daten ein. Die App generiert sofort einen QR-Code, während Sie tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enter any text, URL, email, phone number, or structured data. The app instantly generates a QR code as you type."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduzca cualquier texto, URL, correo electrónico, número de teléfono o datos estructurados. La aplicación genera instantáneamente un código QR mientras escribes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez n'importe quel texte, URL, e-mail, numéro de téléphone ou données structurées. L'application génère instantanément un code QR au fur et à mesure de la saisie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी टेक्स्ट, URL, ईमेल, फोन नंबर या संरचित डेटा दर्ज करें। जैसे ही आप टाइप करते हैं, ऐप तुरंत QR कोड उत्पन्न कर देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserite qualsiasi testo, URL, e-mail, numero di telefono o dati strutturati. L'applicazione genera istantaneamente un codice QR durante la digitazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のテキスト、URL、電子メール、電話番号、または構造化データを入力します。入力と同時にQRコードが生成されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza qualquer texto, URL, e-mail, número de telefone ou dados estruturados. A aplicação gera instantaneamente um código QR à medida que escreve."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入任何文本、URL、电子邮件、电话号码或结构化数据。该应用程序会在您输入的同时立即生成 QR 代码。"
          }
        }
      }
    },
