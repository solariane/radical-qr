    "help.copyVsSave.detail" : {
      "comment" : "Detail text for the \"Copy vs Save\" help row.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ يضع رمز الاستجابة السريعة في الحافظة الخاصة بك للصقه بسرعة. حفظ التصدير إلى ملف يمكنك مشاركته أو أرشفته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren legt den QR-Code zum schnellen Einfügen in die Zwischenablage. Speichern exportiert in eine Datei, die Sie teilen oder archivieren können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copy places the QR code on your clipboard for quick pasting. Save exports to a file you can share or archive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar coloca el código QR en el portapapeles para pegarlo rápidamente. Guardar exporta a un archivo que puedes compartir o archivar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copier place le code QR dans votre presse-papiers pour un collage rapide. Enregistrer exporte vers un fichier que vous pouvez partager ou archiver."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉपी आपके क्लिपबोर्ड पर QR कोड रख देती है ताकि आप इसे जल्दी से पेस्ट कर सकें।  एक्सपोर्ट्स को एक ऐसी फ़ाइल में सहेजें जिसे आप साझा या संग्रहीत कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia inserisce il codice QR negli appunti per incollarlo rapidamente. Salva esporta in un file che può essere condiviso o archiviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーでQRコードをクリップボードに置き、素早く貼り付けることができます。共有またはアーカイブ可能なファイルにエクスポートします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar coloca o código QR na sua área de transferência para colar rapidamente. Guardar exporta para um ficheiro que pode ser partilhado ou arquivado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制将 QR 代码放到剪贴板上，以便快速粘贴。保存导出到可以共享或存档的文件中。"
          }
        }
      }
    },
