    "help.shareExtension.detail" : {
      "comment" : "Detail text for the Share Extension help row.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على مشاركة على رقم هاتف، أو بريد إلكتروني، أو رابط، أو جهة اتصال، أو حدث تقويم في Safari، وجهات الاتصال، والتقويم، والملاحظات، والتطبيقات الأخرى، ثم اختر Radical QR لإنشاء رمز على الفور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf eine Telefonnummer, eine E-Mail, einen Link, einen Kontakt oder ein Kalenderereignis in Safari, Kontakte, Kalender, Notizen und anderen Apps und wählen Sie dann Radical QR, um sofort einen Code zu erzeugen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap Share on a phone number, email, link, contact, or calendar event in Safari, Contacts, Calendar, Notes, and other apps, then pick Radical QR to generate a code instantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Compartir en un número de teléfono, correo electrónico, enlace, contacto o evento de calendario en Safari, Contactos, Calendario, Notas y otras apps, y luego elige Radical QR para generar un código al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur Partager sur un numéro de téléphone, un e-mail, un lien, un contact ou un événement de calendrier dans Safari, Contacts, Calendrier, Notes et autres applications, puis choisissez Radical QR pour générer un code instantanément."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari, Contacts, Calendar, Notes और अन्य ऐप्स में किसी फ़ोन नंबर, ईमेल, लिंक, संपर्क या कैलेंडर इवेंट पर शेयर टैप करें, फिर तुरंत कोड जनरेट करने के लिए Radical QR चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toccate Condividi su un numero di telefono, un'e-mail, un link, un contatto o un evento del calendario in Safari, Contatti, Calendario, Note e altre applicazioni, quindi scegliete Radical QR per generare un codice all'istante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari、連絡先、カレンダー、メモ、その他のアプリケーションで、電話番号、Eメール、リンク、連絡先、カレンダーのイベント上で「共有」をタップし、「Radical QR」を選ぶと、コードが即座に生成されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Partilhar num número de telefone, e-mail, ligação, contacto ou evento de calendário no Safari, Contactos, Calendário, Notas e outras aplicações e, em seguida, escolha Radical QR para gerar um código instantaneamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Safari、通讯录、日历、便笺和其他应用程序中，轻点分享电话号码、电子邮件、链接、联系人或日历事件，然后选择 Radical QR 即可立即生成代码。"
          }
        }
      }
    },
    "help.shareExtension.title" : {
