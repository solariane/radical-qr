    "help.colors.detail" : {
      "comment" : "Detail text for the \"Colors & Gradients\" row in the \"Ways to Create QR Codes\" section of the help view.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر من بين الألوان الصلبة والتدرجات اللونية المحددة مسبقًا، أو افتح منتقي الألوان الكامل مع Pro. تشمل أنواع التدرجات الخطية والشعاعية والزاوية والماسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie aus voreingestellten Volltonfarben und Farbverläufen, oder schalten Sie mit der Pro-Version die volle Farbauswahl frei. Zu den Verlaufstypen gehören linear, radial, eckig und rautenförmig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose from preset solid colors and gradients, or unlock the full color picker with Pro. Gradient types include linear, radial, angular, and diamond."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija entre colores sólidos y degradados predefinidos, o desbloquee el selector de color completo con Pro. Los tipos de degradado incluyen lineal, radial, angular y diamante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez parmi les couleurs unies et les dégradés prédéfinis, ou débloquez le sélecteur de couleurs complet avec Pro. Les types de dégradés comprennent les dégradés linéaires, radiaux, angulaires et en diamant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूर्वनिर्धारित ठोस रंगों और ग्रेडिएंट्स में से चुनें, या Pro के साथ पूर्ण रंग पिकर अनलॉक करें। ग्रेडिएंट प्रकारों में रैखिक, त्रिज्यात्मक, कोणीय और हीरा शामिल हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegliete tra i colori solidi e i gradienti preimpostati, oppure sbloccate il selezionatore di colori completo con Pro. I tipi di gradiente includono quelli lineari, radiali, angolari e a diamante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットのソリッドカラーとグラデーションから選択するか、Proでフルカラーピッカーのロックを解除します。グラデーションの種類には、リニア、ラジアル、アンギュラー、ダイヤモンドがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha entre cores sólidas e gradientes predefinidos ou desbloqueie o seletor de cores completo com o Pro. Os tipos de gradiente incluem linear, radial, angular e diamante."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以从预设的纯色和渐变色中进行选择，也可以使用专业版解锁完整的颜色选择器。渐变类型包括线性、径向、角度和菱形。"
          }
        }
      }
    },
