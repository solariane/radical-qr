    "help.autoDetect.detail" : {
      "comment" : "Detail text for the \"Smart Auto-Detection\" row in the HelpView.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعرف التطبيق تلقائيًا على عناوين URL ورسائل البريد الإلكتروني وأرقام الهواتف وتكوينات Wi-Fi وجهات الاتصال (vCard) وأحداث التقويم (iCal) والمواقع وغيرها. تم تحسين كل نوع للحصول على أفضل تجربة مسح ضوئي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App erkennt automatisch URLs, E-Mails, Telefonnummern, Wi-Fi-Konfigurationen, Kontakte (vCard), Kalenderereignisse (iCal), Orte und mehr. Jeder Typ ist für das beste Scan-Erlebnis optimiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The app automatically recognizes URLs, emails, phone numbers, Wi-Fi configurations, contacts (vCard), calendar events (iCal), locations, and more. Each type is optimized for the best scanning experience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación reconoce automáticamente URL, correos electrónicos, números de teléfono, configuraciones Wi-Fi, contactos (vCard), eventos de calendario (iCal), ubicaciones y mucho más. Cada tipo está optimizado para ofrecer la mejor experiencia de escaneado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application reconnaît automatiquement les URL, les courriels, les numéros de téléphone, les configurations Wi-Fi, les contacts (vCard), les événements du calendrier (iCal), les lieux, etc. Chaque type est optimisé pour une meilleure expérience de numérisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ऐप स्वचालित रूप से यूआरएल, ईमेल, फोन नंबर, वाई-फाई कॉन्फ़िगरेशन, संपर्क (vCard), कैलेंडर इवेंट्स (iCal), स्थान और अन्य को पहचानता है। प्रत्येक प्रकार को सर्वोत्तम स्कैनिंग अनुभव के लिए अनुकूलित किया गया है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'applicazione riconosce automaticamente URL, e-mail, numeri di telefono, configurazioni Wi-Fi, contatti (vCard), eventi del calendario (iCal), località e altro ancora. Ogni tipo è ottimizzato per la migliore esperienza di scansione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは、URL、電子メール、電話番号、Wi-Fi設定、連絡先（vCard）、カレンダーイベント（iCal）、場所などを自動的に認識します。各タイプは、最高のスキャン体験のために最適化されています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aplicação reconhece automaticamente URLs, e-mails, números de telefone, configurações de Wi-Fi, contactos (vCard), eventos de calendário (iCal), localizações e muito mais. Cada tipo é optimizado para a melhor experiência de digitalização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该程序可自动识别 URL、电子邮件、电话号码、Wi-Fi 配置、联系人 (vCard)、日历事件 (iCal)、位置等。每种类型都经过优化，以获得最佳扫描体验。"
          }
        }
      }
    },
