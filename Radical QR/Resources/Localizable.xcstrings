    "help.history.detail" : {
      "comment" : "Detail text for the \"History & iCloud Sync\" row in the \"Pro Features\" section of the Help view.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حفظ آخر 100 رمز QR لك ومزامنتها عبر الأجهزة عبر iCloud. إعادة تحميل أو تكرار الإبداعات السابقة بسرعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine letzten 100 QR-Codes werden gespeichert und über iCloud geräteübergreifend synchronisiert. Schnelles Neuladen oder Duplizieren früherer Kreationen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your last 100 QR codes are saved and synced across devices via iCloud. Quickly reload or duplicate past creations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus últimos 100 códigos QR se guardan y sincronizan entre dispositivos a través de iCloud. Recarga o duplica rápidamente creaciones anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos 100 derniers codes QR sont enregistrés et synchronisés sur tous les appareils via iCloud. Rechargez ou dupliquez rapidement vos créations passées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पिछले 100 QR कोड iCloud के माध्यम से डिवाइसों पर सहेजे और सिंक किए जाते हैं।  पिछली रचनाओं को जल्दी से पुनः लोड या डुप्लिकेट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli ultimi 100 codici QR vengono salvati e sincronizzati su tutti i dispositivi tramite iCloud. Ricaricate o duplicate rapidamente le creazioni passate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去100個のQRコードが保存され、iCloud経由でデバイス間で同期されます。過去に作成したQRコードをすばやく再読み込み、複製できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus últimos 100 códigos QR são guardados e sincronizados entre dispositivos através do iCloud. Recarregue ou duplique rapidamente as criações anteriores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近的 100 个 QR 代码将通过 iCloud 保存并在不同设备间同步。快速重新加载或复制过去的创作。"
          }
        }
      }
    },
