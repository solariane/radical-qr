            "value" : "Links zu Profilen in sozialen Medien. Die App erkennt automatisch die Plattform und den Handle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Links to social media profiles. The app auto-detects the platform and handle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlaces a perfiles de redes sociales. La aplicación detecta automáticamente la plataforma y la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liens vers les profils de médias sociaux. L'application détecte automatiquement la plateforme et la poignée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सोशल मीडिया प्रोफाइल के लिंक। ऐप स्वचालित रूप से प्लेटफ़ॉर्म और हैंडल का पता लगाता है।"
