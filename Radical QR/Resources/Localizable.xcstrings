    "help.privacy.detail" : {
      "comment" : "Privacy policy text.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتوي Radical QR على أي تحليلات، ولا تتبع، ولا جمع بيانات. تتم جميع عمليات المعالجة بالكامل على جهازك. لا يتم إرسال المحتوى الخاص بك إلى أي خادم. يتم تخزين السجل في حاوية iCloud الخاصة بك فقط - لا يمكن لأي شخص آخر الوصول إليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radical QR enthält keine Analytik, kein Tracking und keine Datenerfassung. Die gesamte Verarbeitung erfolgt vollständig auf Ihrem Gerät. Deine Inhalte werden niemals an einen Server gesendet. Der Verlauf wird nur in deinem privaten iCloud-Container gespeichert - niemand sonst kann darauf zugreifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Radical QR contains zero analytics, zero tracking, and zero data collection. All processing happens entirely on your device. Your content is never sent to any server. History is stored only in your private iCloud container -- nobody else can access it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radical QR contiene cero análisis, cero seguimiento y cero recopilación de datos. Todo el procesamiento ocurre enteramente en su dispositivo. Su contenido nunca se envía a ningún servidor. El historial solo se almacena en tu contenedor privado de iCloud: nadie más puede acceder a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radical QR ne contient aucune analyse, aucun suivi et aucune collecte de données. Tout le traitement se fait entièrement sur votre appareil. Votre contenu n'est jamais envoyé à un serveur. L'historique est stocké uniquement dans votre conteneur iCloud privé - personne d'autre ne peut y accéder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radical QR में शून्य विश्लेषण, शून्य ट्रैकिंग और शून्य डेटा संग्रहण होता है। सभी प्रोसेसिंग पूरी तरह से आपके डिवाइस पर होती है। आपकी सामग्री कभी भी किसी सर्वर पर नहीं भेजी जाती। इतिहास केवल आपके निजी iCloud कंटेनर में संग्रहीत होता है -- कोई और इसे एक्सेस नहीं कर सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radical QR non contiene analisi, tracciamento e raccolta di dati. Tutta l'elaborazione avviene interamente sul vostro dispositivo. Il vostro contenuto non viene mai inviato a un server. La cronologia viene memorizzata solo nel vostro contenitore privato di iCloud: nessun altro può accedervi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radical QRは、分析、追跡、データ収集を一切行いません。すべての処理はお客様のデバイス上で行われます。コンテンツがサーバーに送信されることはありません。履歴はあなたのiCloudコンテナにのみ保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Radical QR contém zero análises, zero rastreio e zero recolha de dados. Todo o processamento acontece inteiramente no seu dispositivo. O seu conteúdo nunca é enviado para nenhum servidor. O histórico é armazenado apenas no seu contentor privado do iCloud - ninguém mais pode aceder a ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radical QR 包含零分析、零跟踪和零数据收集。所有处理完全在您的设备上进行。你的内容绝不会发送到任何服务器。历史记录仅存储在您的私人 iCloud 容器中，其他人无法访问。"
          }
        }
      }
    },
