    "help.dragDrop.detail" : {
      "comment" : "Detail text for the \"Drag & Drop\" row in the \"Getting Started\" section of the help view.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسقط الملفات أو النصوص أو عناوين URL من أي تطبيق مباشرةً على النافذة. تتم قراءة الملفات النصية (.txt، .vcf، .ics) تلقائيًا. يمكنك أيضًا إسقاط روابط الويب من Safari أو المتصفحات الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie Dateien, Text oder URLs aus einer beliebigen Anwendung direkt in das Fenster. Textdateien (.txt, .vcf, .ics) werden automatisch gelesen. Sie können auch Weblinks aus Safari oder anderen Browsern ablegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drop files, text, or URLs from any app directly onto the window. Text files (.txt, .vcf, .ics) are read automatically. You can also drop web links from Safari or other browsers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelte archivos, texto o URL desde cualquier aplicación directamente en la ventana. Los archivos de texto (.txt, .vcf, .ics) se leen automáticamente. También puedes soltar enlaces web desde Safari u otros navegadores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez des fichiers, du texte ou des URL à partir de n'importe quelle application directement dans la fenêtre. Les fichiers texte (.txt, .vcf, .ics) sont lus automatiquement. Vous pouvez également déposer des liens web à partir de Safari ou d'autres navigateurs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी ऐप से फ़ाइलें, टेक्स्ट या यूआरएल सीधे विंडो पर ड्रॉप करें। टेक्स्ट फ़ाइलें (.txt, .vcf, .ics) स्वचालित रूप से पढ़ी जाती हैं। आप सफारी या अन्य ब्राउज़रों से वेब लिंक भी ड्रॉप कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilasciate file, testo o URL da qualsiasi applicazione direttamente sulla finestra. I file di testo (.txt, .vcf, .ics) vengono letti automaticamente. È anche possibile rilasciare link web da Safari o altri browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のアプリからファイル、テキスト、URLをウィンドウに直接ドロップ。テキストファイル（.txt、.vcf、.ics）は自動的に読み込まれます。Safariなどのブラウザからウェブリンクをドロップすることもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largue ficheiros, texto ou URLs de qualquer aplicação diretamente na janela. Os ficheiros de texto (.txt, .vcf, .ics) são lidos automaticamente. Também pode largar ligações Web do Safari ou de outros navegadores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将任何应用程序中的文件、文本或 URL 直接拖放到窗口中。文本文件（.txt、.vcf、.ics）可自动读取。您还可以从 Safari 或其他浏览器投放网页链接。"
          }
        }
      }
    },
