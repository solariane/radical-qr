    "help.formats.detail" : {
      "comment" : "Detail text for the \"Export Formats\" row in the HelpView.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التصدير بتنسيق PNG أو JPEG أو WebP. ويحصل المستخدمون المحترفون أيضًا على تنسيقات PDF وSVG المتجهة لقياس مثالي بأي حجم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportieren Sie als PNG, JPEG oder WebP. Pro-Benutzer erhalten auch PDF- und SVG-Vektorformate für perfekte Skalierung in jeder Größe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Export as PNG, JPEG, or WebP. Pro users also get PDF and SVG vector formats for perfect scaling at any size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta como PNG, JPEG o WebP. Los usuarios Pro también obtienen los formatos vectoriales PDF y SVG para un escalado perfecto a cualquier tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportation au format PNG, JPEG ou WebP. Les utilisateurs professionnels bénéficient également des formats vectoriels PDF et SVG pour une mise à l'échelle parfaite à n'importe quelle taille."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG, JPEG या WebP के रूप में निर्यात करें। प्रो उपयोगकर्ताओं को किसी भी आकार में उत्तम स्केलिंग के लिए PDF और SVG वेक्टर प्रारूप भी मिलते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esportazione in formato PNG, JPEG o WebP. Gli utenti Pro ottengono anche i formati vettoriali PDF e SVG per una perfetta scalabilità a qualsiasi dimensione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PNG、JPEG、またはWebPとして書き出せます。プロユーザーはPDFとSVGベクターフォーマットも入手でき、どのサイズでも完璧なスケーリングが可能です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte como PNG, JPEG ou WebP. Os utilizadores Pro também obtêm os formatos vectoriais PDF e SVG para um dimensionamento perfeito em qualquer tamanho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出为 PNG、JPEG 或 WebP 格式。专业版用户还可获得 PDF 和 SVG 矢量格式，以便在任何尺寸下进行完美缩放。"
          }
        }
      }
    },
