    "help.supportedFormats.detail" : {
      "comment" : "Description of the supported data formats section in the help view.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عناوين URL، ورسائل البريد الإلكتروني، وأرقام الهواتف، وشبكة Wi-Fi، وجهات الاتصال، وأحداث التقويم، والمواقع، والنصوص العادية - مع أمثلة قابلة للنسخ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLs, E-Mails, Telefonnummern, Wi-Fi, Kontakte, Kalenderereignisse, Standorte und einfacher Text - mit kopierbaren Beispielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URLs, emails, phone numbers, Wi-Fi, contacts, calendar events, locations, and plain text -- with copyable examples."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL, correos electrónicos, números de teléfono, Wi-Fi, contactos, eventos de calendario, ubicaciones y texto sin formato, con ejemplos copiables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL, courriels, numéros de téléphone, Wi-Fi, contacts, événements du calendrier, lieux et texte brut - avec des exemples à copier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यूआरएल, ईमेल, फोन नंबर, वाई-फाई, संपर्क, कैलेंडर इवेंट, स्थान और सादा पाठ -- कॉपी करने योग्य उदाहरणों के साथ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL, e-mail, numeri di telefono, Wi-Fi, contatti, eventi di calendario, località e testo normale, con esempi da copiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL、電子メール、電話番号、Wi-Fi、連絡先、カレンダーイベント、場所、プレーンテキスト -- コピー可能な例付き。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLs, e-mails, números de telefone, Wi-Fi, contactos, eventos do calendário, localizações e texto simples - com exemplos copiáveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL、电子邮件、电话号码、Wi-Fi、联系人、日历事件、位置和纯文本，并提供可复制的示例。"
          }
        }
      }
    },
