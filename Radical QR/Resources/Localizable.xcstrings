    "help.sizes.detail" : {
      "comment" : "Detail text for the \"Export Sizes\" help row.",
      "extractionState" : "extracted_with_value",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفئة المجانية تصدر حتى 400 بكسل. تفتح الفئة الاحترافية أحجامًا تصل إلى 4096 بكسل لإخراج بجودة الطباعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kostenlose Version exportiert bis zu 400 Pixel. Pro schaltet Größen bis zu 4096px für die Ausgabe in Druckqualität frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Free tier exports up to 400px. Pro unlocks sizes up to 4096px for print-quality output."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión gratuita exporta hasta 400px. Pro desbloquea tamaños de hasta 4096px para una salida de calidad de impresión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version gratuite exporte jusqu'à 400 px. La version Pro débloque des tailles allant jusqu'à 4096px pour une impression de qualité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नि:शुल्क स्तर पर 400px तक का निर्यात। प्रो स्तर प्रिंट-गुणवत्ता वाले आउटपुट के लिए 4096px तक के आकार अनलॉक करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il livello gratuito esporta fino a 400px. Il livello Pro sblocca dimensioni fino a 4096px per una stampa di qualità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料版では400pxまで。Proでは、印刷品質の出力用に4096pxまでのサイズをアンロックできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nível gratuito exporta até 400px. O nível Pro desbloqueia tamanhos até 4096 px para uma saída com qualidade de impressão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费层最高可输出 400px。专业版可解锁高达 4096px 的尺寸，实现打印质量输出。"
          }
        }
      }
    },
